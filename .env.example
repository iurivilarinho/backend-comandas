# Copy to .env (git-ignored) for local development, or paste into the .env of a deployed instance.
# Variables marked REQUIRED have no default: the application refuses to start without them.
# Never commit real values.

# --- Hosting platform (PLT-030, CMD-016) -------------------------------------
# off     = own instance: one database, schema "public", no Central, no plan limits (local development).
# central = hosted (comandas.gloomy.com.br/<customer>): one schema per customer; needs the CENTRAL_* variables below.
CENTRAL_MODE=off
# Only with CENTRAL_MODE=central (infra/templates/app.env.example of aurora-platform lists them all):
# APP_CODE=comandas
# APP_BASE_DOMAIN=comandas.gloomy.com.br
# CENTRAL_URL=https://portal.gloomy.com.br
# CENTRAL_CLIENT_ID=
# CENTRAL_CLIENT_SECRET=
# CENTRAL_WEBHOOK_SECRET=
# PLATFORM_LOCAL_TOKEN=
# PLATFORM_PUBLIC_IPS=

# --- Database ------------------------------------------------------------
# Optional (default jdbc:postgresql://localhost:5432/comandas)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/comandas
# Optional (default postgres)
SPRING_DATASOURCE_USERNAME=postgres
# REQUIRED (SECRET)
SPRING_DATASOURCE_PASSWORD=

# --- HTTP ----------------------------------------------------------------
# Optional (default 9091)
SERVER_PORT=9091
# Optional (default: localhost and 127.0.0.1 on any port). Comma separated; set the public origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- TLS (docker-compose.yml only; not used when running locally or behind the platform nginx) -----------------
# REQUIRED by docker-compose.yml (SECRET): password of the keystore mounted at /etc/ssl/private/keystore.jks
SERVER_SSL_KEY_STORE_PASSWORD=
# Optional (default springboot)
SERVER_SSL_KEY_ALIAS=springboot

# --- JWT -----------------------------------------------------------------
# REQUIRED (SECRET): at least 32 random characters, different for every instance.
# Generate with: openssl rand -base64 48
# Changing it signs every user out and invalidates the printed table QR codes and the customer tokens.
JWT_SECRET=

# --- Initial administrator (own instance only) ---------------------------
# Optional (SECRET): password of the "admin" user created on the first start of an empty database.
# Blank = the admin user is not created. Ignored once the user exists. In the hosted mode the administrator is created
# by the tenant provisioning, from the e-mail of the customer.
APP_ADMIN_PASSWORD=

# --- E-mail (SMTP) -------------------------------------------------------
# Username and password must be defined; they may be empty to run without e-mail.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=587
# REQUIRED
SPRING_MAIL_USERNAME=
# REQUIRED (SECRET)
SPRING_MAIL_PASSWORD=
# Optional: sender address (defaults to SPRING_MAIL_USERNAME)
# MAIL_FROM=

# --- Google sign-in ------------------------------------------------------
# Optional: both blank hides the Google button. The platform brokers the sign-in (PLT-038): in Google Cloud register ONE
# redirect URI, https://{APP_BASE_DOMAIN}/__platform/google/callback, and no JavaScript origins. Only users the
# restaurant already registered can sign in with Google.
GOOGLE_CLIENT_ID=
# (SECRET)
GOOGLE_CLIENT_SECRET=

# --- Cloudflare Turnstile (PLT-033) -----------------------------------------
# Optional: both set turns the human check on for login and password recovery request.
# TURNSTILE_SITE_KEY=
# (SECRET)
# TURNSTILE_SECRET_KEY=

# --- Web Push (VAPID) ----------------------------------------------------
# Optional. Generate one pair per instance with: npx web-push generate-vapid-keys
# Blank keeps push notifications disabled.
PUSH_VAPID_PUBLIC_KEY=
# (SECRET)
PUSH_VAPID_PRIVATE_KEY=
# Optional (default mailto:no-reply@comandas.local). Use a real contact address of the instance.
# PUSH_VAPID_SUBJECT=mailto:contato@example.com
